# 배포 산출물 — 절대 커밋하지 않는다.
# 한 번 커밋한 대용량 zip은 지워도 git 히스토리에 영구히 남는다.
dist/
*.zip

# 사이트 빌드 시 game/ 을 복사해 넣는 자리
site/play/

# OS 부스러기
.DS_Store
Thumbs.db
desktop.ini

# /design 로 구운 캔버스 — 2MB 편집기가 통째로 들어 있는 산출물이라 담지 않는다
design/*.html
!design/*.dc.html

# 파이썬 도구가 만드는 캐시 — 저장소에 들어갈 것이 아니다
tools/__pycache__/
