{
  "name": "ashfall-chronicles",
  "private": true,
  "version": "1.1.0",
  "description": "Ashfall Chronicles — 별이 잠든 땅. 원본은 src/, game/ 은 실행 폴더(번들을 커밋해 빌드 없이 돈다). 이 파일은 묶기·검사 도구만 싣는다.",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "node tools/bundle.mjs",
    "serve": "node tests/serve.mjs",
    "test:syntax": "node tests/syntax.mjs",
    "test:modules": "node tests/modules.mjs && node tools/imports.mjs --check",
    "test:i18n": "node tests/i18n.mjs",
    "typecheck": "tsc -p .",
    "test:manifest": "python3 tools/sync-manifest.py --check",
    "test:gen": "node tests/gen-hash.mjs",
    "test:play": "node tests/play.mjs",
    "test:pseudo": "node tests/pseudo.mjs",
    "test:shots": "node tests/shots.mjs",
    "baseline": "node tests/gen-hash.mjs --update && node tests/shots.mjs --update",
    "check": "npm run test:syntax && npm run typecheck && npm run test:modules && npm run test:i18n && npm run test:manifest && npm run test:gen && npm run test:play && npm run test:pseudo && npm run test:shots"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "esbuild": "0.28.2",
    "eslint-scope": "9.1.2",
    "globals": "17.12.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
