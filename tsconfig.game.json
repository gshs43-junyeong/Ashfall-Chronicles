{
  "//": "게임(src/game) 타입 검사 — 아직 느슨하게(strict 끔). @ts-nocheck 를 뗀 파일만 본다. 파일마다 타입을 좁히며 엄격하게 올린다(계획서 §7-1).",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": false,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/game/**/*.ts"]
}
