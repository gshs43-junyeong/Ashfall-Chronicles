{
  "//": "타입 검사만 한다(noEmit) — 묶기는 esbuild 가 한다. 엔진(src/engine)은 strict. 게임(src/game)은 파일마다 @ts-nocheck 를 떼며 차례로 타입을 입힌다.",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src/engine/**/*.ts", "src/game/**/*.ts"]
}
