{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash tools/build-site.sh",
  "outputDirectory": "site",
  "framework": null,
  "headers": [
    {
      "source": "/play/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/play/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
